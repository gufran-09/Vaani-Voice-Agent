# Amazon RDS for PostgreSQL. Keep this server-only; never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://vaani_app:change-me@your-rds-endpoint:5432/vaani
DATABASE_SSL=true

# Amazon Cognito User Pool
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_example
COGNITO_CLIENT_ID=exampleclientid
